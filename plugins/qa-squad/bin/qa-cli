#!/usr/bin/env python3
"""Minimal, dependency-free QA state and coverage CLI.

The CLI owns the deterministic part of a QA audit: the inventory (the
denominator), the recorded results (the numerator), findings, and the
completion gate. It intentionally has no third-party dependencies so it can run
anywhere Claude Code runs.

Design rules:
  * An item counts as covered only when a result has been persisted for it.
  * An empty category is never silently treated as complete. It must be
    explicitly declared empty with a justification, which is auditable.
  * Coverage measures execution, not quality. A failed test still counts as
    covered; it is the findings that carry quality signal.
"""
from __future__ import annotations

import argparse
import datetime as dt
import hashlib
import json
import os
import re
import shutil
import subprocess
import sys
from pathlib import Path

ROOT = Path(os.environ.get("CLAUDE_PROJECT_DIR", Path.cwd())).resolve()
QA = ROOT / ".qa"
INV = QA / "inventory"
RES = QA / "results"
FIND = QA / "findings"
REPORTS = QA / "reports"
EVIDENCE = QA / "evidence"
STATE = QA / "run-state.json"
CONFIG = QA / "config.json"
DECLARED_EMPTY = QA / "declared-empty.json"

SCENARIO_SCAN = QA / "scenario-scan.json"

# Deterministic, publishable QA artifacts. This subsystem is read-only with
# respect to `.qa/` (it only reads the inventory and recorded results from
# there) except for stamping `bug_id` onto a result it already exported into
# `docs/qa/`, which is its own territory.
DOCS_QA = ROOT / "docs" / "qa"
DOCS_EXECUTIONS = DOCS_QA / "executions"
DOCS_REPORTS = DOCS_QA / "reports"
DOCS_BUGS = DOCS_QA / "bugs"
DOCS_EVIDENCE = DOCS_QA / "evidence"
DOCS_SUMMARY = DOCS_QA / "summary"

# Core categories gate audit completion by default. `scenarios` holds the test
# scenarios themselves: the ones that already exist in the project, or the ones
# generated from the inventory when the project has none.
CORE_CATEGORIES = ["profiles", "navigation", "features", "forms", "workflows", "permissions", "scenarios"]
SCENARIOS = "scenarios"

# Extended categories give every specialized agent a measurable coverage lane.
# They are tracked and reported by default, and can be promoted into
# required_categories when an audit must formally gate on them.
EXTENDED_CATEGORIES = [
    "api", "ux", "ui", "responsive", "accessibility",
    "security", "performance", "resilience", "data-integrity",
]

KNOWN_CATEGORIES = CORE_CATEGORIES + EXTENDED_CATEGORIES

# Every one of these statuses means "execution happened". Coverage is about
# execution; quality is carried by findings and by the status breakdown.
COUNTED = {"passed", "failed", "blocked", "not_applicable"}

# Canonical severities, with the P-scale kept as accepted aliases for
# backward compatibility with existing audits and reports.
SEVERITY_ALIASES = {
    "p0": "critical", "critical": "critical",
    "p1": "high", "high": "high",
    "p2": "medium", "medium": "medium",
    "p3": "low", "low": "low",
}
SEVERITY_TO_P = {"critical": "P0", "high": "P1", "medium": "P2", "low": "P3"}
SEVERITY_ORDER = ["critical", "high", "medium", "low"]

CATEGORY_RE = re.compile(r"^[a-z0-9][a-z0-9._-]*$")

# Deterministic export statuses. `not_applicable` is a status of its own: it is
# shown, but it never counts for or against acceptance.
STATUS_MAP = {
    "passed": "PASS",
    "failed": "FAIL",
    "blocked": "BLOCKED",
    "not_applicable": "NOT_APPLICABLE",
}
EXPORT_STATUSES = ["PASS", "FAIL", "BLOCKED", "NOT_EXECUTED", "NOT_APPLICABLE"]

# Canonical list — keep plugins/qa-squad/agents/qa-scenario-tester.md's classification
# guidance in sync with this.
BUG_CLASSIFICATIONS = [
    "PRODUCT_DEFECT", "TEST_AUTOMATION_FAILURE", "ENVIRONMENT_FAILURE",
    "TEST_DATA_FAILURE", "BLOCKED", "UNDETERMINED",
]
# Classifications that keep a FAIL from being a confirmed product defect, but
# also keep it from being clean: the requirement cannot be accepted, but it
# also cannot be rejected on this evidence alone.
INCONCLUSIVE_BUG_CLASSIFICATIONS = {
    "TEST_AUTOMATION_FAILURE", "ENVIRONMENT_FAILURE", "TEST_DATA_FAILURE",
    "UNDETERMINED", "BLOCKED",
}

BINARY_EVIDENCE_EXTENSIONS = {".png", ".jpg", ".jpeg", ".webp", ".webm", ".mp4", ".zip"}


def now() -> str:
    return dt.datetime.now(dt.timezone.utc).isoformat()


def load(path: Path, default=None):
    if not path.exists():
        return default
    return json.loads(path.read_text(encoding="utf-8"))


def save(path: Path, data) -> None:
    path.parent.mkdir(parents=True, exist_ok=True)
    tmp = path.with_suffix(path.suffix + ".tmp")
    tmp.write_text(json.dumps(data, indent=2, ensure_ascii=False) + "\n", encoding="utf-8")
    tmp.replace(path)


def ensure_dirs() -> None:
    for p in [INV, RES, FIND, REPORTS, EVIDENCE / "screenshots", EVIDENCE / "traces", EVIDENCE / "videos"]:
        p.mkdir(parents=True, exist_ok=True)


def ensure_docs_dirs() -> None:
    for p in [DOCS_EXECUTIONS, DOCS_REPORTS, DOCS_BUGS, DOCS_EVIDENCE, DOCS_SUMMARY]:
        p.mkdir(parents=True, exist_ok=True)


def require_initialized() -> None:
    if not STATE.exists():
        raise SystemExit("QA state not found. Run 'qa-cli init' first.")


def validate_category(name: str) -> str:
    if not CATEGORY_RE.match(name):
        raise SystemExit(
            f"Invalid category '{name}'. Use lowercase slugs such as: {', '.join(KNOWN_CATEGORIES)}"
        )
    return name


def normalize_severity(value: str) -> str:
    key = (value or "").strip().lower()
    if key not in SEVERITY_ALIASES:
        raise SystemExit(
            "Invalid severity. Use critical|high|medium|low (P0|P1|P2|P3 are accepted aliases)."
        )
    return SEVERITY_ALIASES[key]


def init(args) -> None:
    ensure_dirs()
    # Materialize the project-local QA templates shipped with the plugin.
    templates = Path(__file__).resolve().parent / "templates"
    if templates.exists():
        for name in ["SCHEMA.md", "project-context.example.md", ".gitignore"]:
            src = templates / name
            dst = QA / name
            if src.exists() and not dst.exists():
                shutil.copy2(src, dst)
    if not CONFIG.exists():
        save(CONFIG, {
            "required_coverage_percent": 100,
            "required_categories": CORE_CATEGORIES,
            "tracked_categories": EXTENDED_CATEGORIES,
            "strict_navigation_by_profile": True,
            "required_viewports": ["desktop", "mobile"],
            "allowed_result_statuses": sorted(COUNTED),
            "severity_scale": SEVERITY_ORDER,
            "notes": (
                "Adapt categories and requirements to the project, but do not lower navigation "
                "coverage when the audit goal is 100% of menus and submenus. Promote a tracked "
                "category into required_categories to make the audit gate on it."
            ),
        })
    if not DECLARED_EMPTY.exists():
        save(DECLARED_EMPTY, {})
    if not STATE.exists() or args.force:
        save(STATE, {
            "status": "active",
            "started_at": now(),
            "updated_at": now(),
            "discovery_complete": False,
            "discovery_notes": "",
            "audit_goal": args.goal or "Full generic QA audit",
            "finished_at": None,
        })
    else:
        state = load(STATE, {}) or {}
        state["status"] = "active"
        state["updated_at"] = now()
        if args.goal:
            state["audit_goal"] = args.goal
        save(STATE, state)
    print(f"QA initialized at {QA}")


def inventory_path(cat: str) -> Path:
    return INV / f"{cat}.json"


def normalize_inventory(data):
    if data is None:
        return []
    if isinstance(data, list):
        return data
    if isinstance(data, dict) and isinstance(data.get("items"), list):
        return data["items"]
    raise ValueError("Inventory must be a JSON list or an object shaped as {\"items\": [...]}")


def add_inventory(args) -> None:
    ensure_dirs()
    cat = validate_category(args.category)
    path = inventory_path(cat)
    items = normalize_inventory(load(path, []))
    existing = {str(x.get("id")): x for x in items if x.get("id") is not None}
    payload = {
        "id": args.id,
        "kind": args.kind,
        "label": args.label,
        "profile_id": args.profile_id,
        "route": args.route,
        "parent_id": args.parent_id,
        "metadata": json.loads(args.metadata) if args.metadata else {},
        "discovered_at": now(),
    }
    existing[args.id] = payload
    save(path, {"category": cat, "items": list(existing.values())})
    # Adding an item to a category contradicts any previous "this category is
    # empty" declaration, so the declaration is retired automatically.
    declared = load(DECLARED_EMPTY, {}) or {}
    if cat in declared:
        declared.pop(cat)
        save(DECLARED_EMPTY, declared)
    print(f"inventory:{cat}:{args.id}")


def result_filename(item_id: str) -> str:
    return hashlib.sha256(item_id.encode("utf-8")).hexdigest()[:24] + ".json"


def record(args) -> None:
    ensure_dirs()
    cat = validate_category(args.category)
    if args.status not in COUNTED:
        raise SystemExit(f"Invalid status '{args.status}'. Use one of: {', '.join(sorted(COUNTED))}")
    if args.status == "not_applicable" and not args.notes:
        raise SystemExit("Status 'not_applicable' requires a --notes justification.")
    if args.status == "blocked" and not args.notes:
        raise SystemExit("Status 'blocked' requires --notes explaining what blocked execution.")
    inventoried = {str(x.get("id")) for x in normalize_inventory(load(inventory_path(cat), []))}
    if args.id not in inventoried:
        # The result is kept, but it cannot count towards coverage until an
        # inventory item with the same ID exists. A typo here is otherwise silent.
        print(
            f"warning: '{args.id}' is not in the {cat} inventory; this result will not count "
            f"towards coverage until the item is inventoried.",
            file=sys.stderr,
        )
    path = RES / cat / result_filename(args.id)
    data = {
        "id": args.id,
        "category": cat,
        "status": args.status,
        "tested_at": now(),
        "profile_id": args.profile_id,
        "evidence": [e for e in (args.evidence or []) if e],
        "notes": args.notes or "",
        "scenario": args.scenario or "",
        "finding_ids": args.finding_id or [],
        "tester": args.tester or "claude",
    }
    save(path, data)
    print(f"recorded:{cat}:{args.id}:{args.status}")


def add_finding(args) -> None:
    ensure_dirs()
    severity = normalize_severity(args.severity)
    fid = args.id or (
        f"QA-{dt.datetime.now().strftime('%Y%m%d%H%M%S')}-"
        f"{hashlib.sha1((args.title + now()).encode()).hexdigest()[:5]}"
    )
    data = {
        "id": fid,
        "title": args.title,
        "severity": severity,
        "severity_code": SEVERITY_TO_P[severity],
        "category": validate_category(args.category),
        "profile_id": args.profile_id,
        "location": args.location,
        "actual": args.actual,
        "expected": args.expected,
        "reproduction": args.reproduction,
        "impact": args.impact,
        "recommendation": args.recommendation,
        "evidence": args.evidence or [],
        "created_at": now(),
    }
    save(FIND / f"{fid}.json", data)
    print(fid)


def declare_empty(args) -> None:
    """Explicitly declare a category as having no applicable items.

    This is the only supported way for an empty category to count as complete.
    Without it, an empty category reports 0% and blocks completion, which is
    what prevents a zero-discovery audit from reporting a false 100%.
    """
    ensure_dirs()
    require_initialized()
    cat = validate_category(args.category)
    if cat == SCENARIOS:
        raise SystemExit(
            "The 'scenarios' category cannot be declared empty. When the project has no test "
            "scenarios, generate them from the inventory and execute them instead."
        )
    items = normalize_inventory(load(inventory_path(cat), []))
    if items:
        raise SystemExit(
            f"Category '{cat}' already has {len(items)} inventoried item(s); it cannot be declared empty."
        )
    declared = load(DECLARED_EMPTY, {}) or {}
    declared[cat] = {"reason": args.notes, "declared_at": now()}
    save(DECLARED_EMPTY, declared)
    print(f"declared-empty:{cat}")


def mark_discovery(args) -> None:
    ensure_dirs()
    state = load(STATE, {}) or {}
    if not state:
        raise SystemExit("QA state not found. Run 'qa-cli init' first.")
    state["discovery_complete"] = True
    state["discovery_notes"] = args.notes or ""
    state["updated_at"] = now()
    save(STATE, state)
    print("discovery_complete=true")


def load_results(cat: str) -> dict:
    results: dict[str, dict] = {}
    result_dir = RES / cat
    if result_dir.exists():
        for p in result_dir.glob("*.json"):
            try:
                r = load(p, {}) or {}
                if r.get("id"):
                    results[str(r["id"])] = r
            except (json.JSONDecodeError, OSError):
                continue
    return results


def category_status(cat: str, declared: dict) -> dict:
    items = normalize_inventory(load(inventory_path(cat), []))
    ids = [str(x.get("id")) for x in items if x.get("id") is not None]
    results = load_results(cat)
    tested = [i for i in ids if results.get(i, {}).get("status") in COUNTED]
    missing = [i for i in ids if i not in tested]
    total = len(ids)

    declaration = declared.get(cat)
    if total == 0:
        # An empty category is only complete when it has been explicitly and
        # justifiably declared empty. Otherwise it is undiscovered work.
        coverage = 100.0 if declaration else 0.0
    else:
        coverage = round(len(tested) * 100.0 / total, 2)

    status_counts: dict[str, int] = {}
    for i in tested:
        s = results[i]["status"]
        status_counts[s] = status_counts.get(s, 0) + 1

    return {
        "total": total,
        "tested": len(tested),
        "coverage_percent": coverage,
        "missing": missing,
        "status_counts": status_counts,
        "empty": total == 0,
        "declared_empty": bool(declaration),
        "declared_empty_reason": (declaration or {}).get("reason"),
    }


def load_findings() -> list[dict]:
    out = []
    if FIND.exists():
        for p in sorted(FIND.glob("*.json")):
            try:
                out.append(load(p, {}) or {})
            except (json.JSONDecodeError, OSError):
                continue
    return out


def status_data() -> dict:
    config = load(CONFIG, {}) or {}
    state = load(STATE, {}) or {}
    declared = load(DECLARED_EMPTY, {}) or {}

    required = config.get("required_categories") or CORE_CATEGORIES
    tracked = config.get("tracked_categories") or EXTENDED_CATEGORIES

    # Report anything that is required, tracked, or has produced real data, so
    # that specialized-agent coverage never becomes invisible.
    seen = set(required) | set(tracked)
    if INV.exists():
        seen |= {p.stem for p in INV.glob("*.json")}
    if RES.exists():
        seen |= {p.name for p in RES.iterdir() if p.is_dir()}

    details = {c: category_status(c, declared) for c in sorted(seen)}
    threshold = float(config.get("required_coverage_percent", 100))

    blocking = [c for c in required if details.get(c, {}).get("coverage_percent", 0) < threshold]
    # When scenarios gate the audit, the project must have been scanned for the
    # scenarios it already has. Otherwise generated scenarios could silently
    # replace existing ones instead of complementing them.
    scan_required = SCENARIOS in required
    scan_done = bool(state.get("scenario_scan"))
    complete = (
        bool(state.get("discovery_complete"))
        and not blocking
        and (scan_done or not scan_required)
    )

    findings = load_findings()
    severity_counts = {s: 0 for s in SEVERITY_ORDER}
    for f in findings:
        sev = f.get("severity")
        if sev in severity_counts:
            severity_counts[sev] += 1

    return {
        "state": state,
        "config": config,
        "required_categories": required,
        "tracked_categories": tracked,
        "categories": details,
        "blocking_categories": blocking,
        "scenario_scan_required": scan_required,
        "scenario_scan": state.get("scenario_scan"),
        "findings_total": len(findings),
        "findings_by_severity": severity_counts,
        "complete": complete,
    }


def status(args) -> None:
    data = status_data()
    if args.json:
        print(json.dumps(data, indent=2, ensure_ascii=False))
        return
    st = data["state"]
    print(f"QA status: {st.get('status', 'not-initialized')} | discovery_complete={st.get('discovery_complete', False)}")
    required = set(data["required_categories"])
    print(f"{'category':18} {'tested':>7}/{'total':<7} {'coverage':>9}  gate      breakdown")
    for c, v in data["categories"].items():
        gate = "REQUIRED" if c in required else "tracked"
        note = ""
        if v["empty"]:
            note = " (declared empty)" if v["declared_empty"] else " (EMPTY - NOT DISCOVERED)"
        print(
            f"{c:18} {v['tested']:>7}/{v['total']:<7} {v['coverage_percent']:>8.2f}%  "
            f"{gate:9} {v['status_counts']}{note}"
        )
    sev = data["findings_by_severity"]
    print(
        f"findings: {data['findings_total']} "
        f"(critical={sev['critical']} high={sev['high']} medium={sev['medium']} low={sev['low']})"
    )
    print("COMPLETE" if data["complete"] else "INCOMPLETE")


def validate(args) -> int:
    data = status_data()
    if data["complete"]:
        print("QA coverage validation: PASS")
        return 0
    print("QA coverage validation: FAIL")
    if not data["state"].get("discovery_complete"):
        print("- discovery is not marked complete")
    if data["scenario_scan_required"] and not data["scenario_scan"]:
        print("- the project has not been scanned for existing test scenarios; run 'qa-cli scenario-scan'")
    threshold = float(data["config"].get("required_coverage_percent", 100))
    for c in data["required_categories"]:
        v = data["categories"].get(c)
        if v is None or v["coverage_percent"] >= threshold:
            continue
        if v["empty"] and c == SCENARIOS:
            print(
                f"- {c}: no test scenarios. Import the existing ones with 'qa-cli scenario-scan "
                f"--import', or generate them from the inventory, then execute them."
            )
            continue
        if v["empty"]:
            print(
                f"- {c}: no items discovered. Either inventory this category or run "
                f"'qa-cli declare-empty --category {c} --notes \"<justification>\"'."
            )
            continue
        print(f"- {c}: {v['coverage_percent']}% ({v['tested']}/{v['total']}); missing={len(v['missing'])}")
        for x in v["missing"][:15]:
            print(f"    * {x}")
        if len(v["missing"]) > 15:
            print(f"    ... +{len(v['missing']) - 15} more")
    return 2


def build_matrix() -> list[dict]:
    """Build the traceability matrix rows from inventory and results."""
    data = status_data()
    declared = load(DECLARED_EMPTY, {}) or {}
    rows: list[dict] = []

    # Index navigation items so menu/submenu ancestry can be resolved by id.
    nav_index: dict[str, dict] = {}
    for item in normalize_inventory(load(inventory_path("navigation"), [])):
        if item.get("id") is not None:
            nav_index[str(item["id"])] = item

    def ancestry(item: dict) -> tuple[str, str]:
        """Return (menu, submenu) labels for a navigation item."""
        chain: list[dict] = []
        cursor: dict | None = item
        seen: set[str] = set()
        while cursor is not None:
            cid = str(cursor.get("id"))
            if cid in seen:
                break  # defensive: never loop on a malformed parent chain
            seen.add(cid)
            chain.append(cursor)
            parent_id = cursor.get("parent_id")
            cursor = nav_index.get(str(parent_id)) if parent_id else None
        chain.reverse()
        labels = [str(c.get("label") or c.get("id") or "") for c in chain]
        menu = labels[0] if labels else ""
        submenu = labels[1] if len(labels) > 1 else ""
        return menu, submenu

    for cat in data["categories"]:
        items = normalize_inventory(load(inventory_path(cat), []))
        results = load_results(cat)
        if not items:
            rows.append({
                "area": cat,
                "role": "",
                "menu": "",
                "submenu": "",
                "feature": "",
                "scenario": "",
                "test": "",
                "status": "DECLARED EMPTY" if cat in declared else "NOT TESTED",
                "evidence": (declared.get(cat) or {}).get("reason", "") if cat in declared else "",
            })
            continue
        for item in items:
            iid = str(item.get("id"))
            result = results.get(iid)
            menu, submenu = ancestry(item) if cat == "navigation" else ("", "")
            rows.append({
                "area": cat,
                "role": str(item.get("profile_id") or ""),
                "menu": menu,
                "submenu": submenu,
                "feature": str(item.get("label") or ""),
                "scenario": (result or {}).get("scenario") or str(item.get("kind") or ""),
                "test": iid,
                "status": (result or {}).get("status", "").upper() or "NOT TESTED",
                "evidence": ", ".join((result or {}).get("evidence", []) or []),
            })
    return rows


def matrix(args) -> int:
    rows = build_matrix()
    if args.format == "json":
        out = json.dumps({"rows": rows, "total": len(rows)}, indent=2, ensure_ascii=False)
    else:
        header = ["Area", "Role", "Menu", "Submenu", "Feature", "Scenario", "Test", "Status", "Evidence"]
        keys = ["area", "role", "menu", "submenu", "feature", "scenario", "test", "status", "evidence"]
        lines = ["| " + " | ".join(header) + " |", "|" + "---|" * len(header)]
        for r in rows:
            cells = [str(r[k]).replace("|", "\\|") for k in keys]
            lines.append("| " + " | ".join(cells) + " |")
        untested = sum(1 for r in rows if r["status"] in {"NOT TESTED", "BLOCKED"})
        lines.append("")
        lines.append(f"Rows: {len(rows)} | not tested or blocked: {untested}")
        out = "\n".join(lines)

    if args.out:
        target = Path(args.out)
        if not target.is_absolute():
            target = ROOT / target
        target.parent.mkdir(parents=True, exist_ok=True)
        target.write_text(out + "\n", encoding="utf-8")
        print(f"matrix written: {target}")
    else:
        print(out)
    return 0


# ------------------------------------------------------------------ scenarios
#
# The scan answers one question deterministically: does this project already
# have test scenarios? Existing scenarios are imported and executed; when there
# are none, the scenarios category stays empty and blocks completion until
# scenarios are generated from the inventory and executed.

SCAN_SKIP_DIRS = {
    ".git", ".hg", ".svn", ".qa", "node_modules", "bower_components", "vendor", "dist",
    "build", "out", "target", "coverage", ".next", ".nuxt", ".svelte-kit", ".turbo",
    ".cache", ".venv", "venv", "env", "__pycache__", ".pytest_cache", ".mypy_cache",
    ".tox", ".idea", ".vscode", "playwright-report", "test-results",
}
SCAN_MAX_FILES = 50000

JS_TEST_RE = re.compile(r"\.(spec|test|cy|e2e)\.[cm]?[jt]sx?$", re.I)
UNIT_TEST_RES = [
    re.compile(r"^test_.+\.py$"), re.compile(r".+_test\.py$"), re.compile(r".+_test\.go$"),
    re.compile(r".+(Test|Tests|IT)\.(java|kt|cs)$"), re.compile(r".+_spec\.rb$"),
]
E2E_PATH_RE = re.compile(r"(^|/)(e2e|cypress|playwright|tests?-e2e|acceptance)(/|$)", re.I)
E2E_IMPORT_RE = re.compile(r"@playwright/test|from ['\"]cypress|\bcy\.visit\(|webdriverio|puppeteer|selenium")
DOC_EXTENSIONS = {".md", ".csv", ".xlsx", ".xls", ".txt", ".tsv"}
# Documented scenarios are matched by name. The Portuguese forms are real file
# names found in Brazilian projects, so they are matched on purpose.
DOC_NAME_RE = re.compile(
    r"test[-_ ]?(case|plan|scenario|script|suite)s?|scenarios?|cenarios?|casos?[-_ ]de[-_ ]teste|roteiros?[-_ ]de[-_ ]teste",
    re.I,
)
DOC_DIR_RE = re.compile(r"(^|/)(test[-_]?(cases|plans|scenarios)|scenarios|qa)(/|$)", re.I)
GHERKIN_FEATURE_RE = re.compile(r"^\s*(Feature|Funcionalidade|Caracter[ií]stica)\s*:\s*(.+)$")
GHERKIN_SCENARIO_RE = re.compile(
    r"^\s*(Scenario Outline|Scenario Template|Scenario|Example|Esquema do Cen[aá]rio|Cen[aá]rio|Exemplo)\s*:\s*(.+)$"
)
JS_TITLE_RE = re.compile(
    r"\b(?:test|it)(?:\.(?:only|skip|fixme|fail|slow))?\s*\(\s*(['\"`])((?:\\.|(?!\1).)+?)\1"
)
RUNNER_CONFIGS = {
    "playwright": re.compile(r"^playwright\.config\.[cm]?[jt]s$"),
    "cypress": re.compile(r"^cypress\.config\.[cm]?[jt]s$|^cypress\.json$"),
    "jest": re.compile(r"^jest\.config\.[cm]?[jt]s(on)?$"),
    "vitest": re.compile(r"^vitest\.config\.[cm]?[jt]s$"),
    "pytest": re.compile(r"^(pytest\.ini|conftest\.py)$"),
    "cucumber": re.compile(r"^cucumber\.(js|cjs|mjs|json|ya?ml)$"),
}
TEST_SCRIPT_RE = re.compile(r"(^|:)(test|e2e|cypress|playwright)", re.I)


def _walk(root: Path):
    count = 0
    for dirpath, dirnames, filenames in os.walk(root):
        dirnames[:] = sorted(d for d in dirnames if d not in SCAN_SKIP_DIRS and not d.startswith(".") or d in {".github"})
        for name in sorted(filenames):
            count += 1
            if count > SCAN_MAX_FILES:
                return
            yield Path(dirpath) / name


def _read_text(path: Path, limit: int = 400_000) -> str:
    try:
        with path.open("r", encoding="utf-8", errors="replace") as fh:
            return fh.read(limit)
    except OSError:
        return ""


def _slug(text: str) -> str:
    return re.sub(r"\s+", " ", text).strip()[:160]


def scan_scenarios(root: Path) -> dict:
    """Find the test scenarios a project already has, grouped by origin."""
    report = {
        "gherkin": [], "e2e": [], "unit": [], "documented": [], "runners": [], "scripts": [],
    }
    for path in _walk(root):
        rel = path.relative_to(root).as_posix()
        name = path.name
        for runner, rx in RUNNER_CONFIGS.items():
            if rx.match(name):
                report["runners"].append({"runner": runner, "config": rel})
        if name == "pyproject.toml" and "[tool.pytest" in _read_text(path, 200_000):
            report["runners"].append({"runner": "pytest", "config": rel})
        if name == "package.json" and "node_modules" not in rel:
            try:
                scripts = (json.loads(_read_text(path)) or {}).get("scripts") or {}
            except (json.JSONDecodeError, AttributeError):
                scripts = {}
            for key, cmd in scripts.items():
                if TEST_SCRIPT_RE.search(key):
                    report["scripts"].append({"file": rel, "name": key, "command": str(cmd)})

        if name.endswith(".feature"):
            text = _read_text(path)
            feature, scenarios = "", []
            for lineno, line in enumerate(text.splitlines(), 1):
                m = GHERKIN_FEATURE_RE.match(line)
                if m and not feature:
                    feature = _slug(m.group(2))
                m = GHERKIN_SCENARIO_RE.match(line)
                if m:
                    scenarios.append({"title": _slug(m.group(2)), "line": lineno})
            report["gherkin"].append({"file": rel, "feature": feature, "scenarios": scenarios})
            continue

        if JS_TEST_RE.search(name):
            text = _read_text(path)
            if E2E_PATH_RE.search(rel) or ".cy." in name or ".e2e." in name or E2E_IMPORT_RE.search(text[:8000]):
                tests = []
                for lineno, line in enumerate(text.splitlines(), 1):
                    for m in JS_TITLE_RE.finditer(line):
                        tests.append({"title": _slug(m.group(2)), "line": lineno})
                report["e2e"].append({"file": rel, "tests": tests})
            else:
                report["unit"].append(rel)
            continue

        if any(rx.match(name) for rx in UNIT_TEST_RES):
            report["unit"].append(rel)
            continue

        if path.suffix.lower() in DOC_EXTENSIONS and (DOC_NAME_RE.search(path.stem) or DOC_DIR_RE.search(rel)):
            if name.lower() in {"readme.md", "changelog.md", "license.txt"}:
                continue
            report["documented"].append(rel)

    counts = {
        "gherkin_files": len(report["gherkin"]),
        "gherkin_scenarios": sum(len(f["scenarios"]) for f in report["gherkin"]),
        "e2e_files": len(report["e2e"]),
        "e2e_tests": sum(len(f["tests"]) for f in report["e2e"]),
        "unit_files": len(report["unit"]),
        "documented_files": len(report["documented"]),
        "runners": len(report["runners"]),
    }
    # Unit tests are real tests, but they are not user-facing QA scenarios. They
    # are executed as whole suites, so they do not make "found" true on their own.
    found = bool(counts["gherkin_scenarios"] or counts["e2e_tests"] or counts["documented_files"])
    return {"scanned_at": now(), "root": str(root), "found": found, "counts": counts, "sources": report}


def scenario_items(scan: dict) -> list[dict]:
    """Turn scan results into inventory items for the scenarios category."""
    items: list[dict] = []
    src = scan["sources"]
    for f in src["gherkin"]:
        for s in f["scenarios"]:
            items.append({
                "id": f"scenario:gherkin:{f['file']}::{s['title']}",
                "kind": "gherkin",
                "label": s["title"],
                "metadata": {"origin": "existing", "source": f["file"], "line": s["line"], "feature": f["feature"]},
            })
    for f in src["e2e"]:
        for t in f["tests"]:
            items.append({
                "id": f"scenario:e2e:{f['file']}::{t['title']}",
                "kind": "e2e",
                "label": t["title"],
                "metadata": {"origin": "existing", "source": f["file"], "line": t["line"]},
            })
    # One item per way of running the automated suites, so that running them is
    # itself a tracked, recorded execution.
    seen_suites = set()
    for s in src["scripts"]:
        sid = f"scenario:suite:{s['file']}#{s['name']}"
        if sid not in seen_suites:
            seen_suites.add(sid)
            items.append({
                "id": sid, "kind": "suite", "label": f"{s['name']}: {s['command']}",
                "metadata": {"origin": "existing", "source": s["file"], "command": s["command"]},
            })
    if src["unit"] and not src["scripts"]:
        for r in src["runners"]:
            sid = f"scenario:suite:{r['config']}"
            if sid not in seen_suites:
                seen_suites.add(sid)
                items.append({
                    "id": sid, "kind": "suite", "label": f"{r['runner']} suite",
                    "metadata": {"origin": "existing", "source": r["config"], "runner": r["runner"]},
                })
    return items


def scenario_scan(args) -> int:
    ensure_dirs()
    require_initialized()
    scan = scan_scenarios(ROOT)
    save(SCENARIO_SCAN, scan)

    imported = 0
    if args.do_import:
        path = inventory_path(SCENARIOS)
        existing = {str(x.get("id")): x for x in normalize_inventory(load(path, [])) if x.get("id") is not None}
        for item in scenario_items(scan):
            if item["id"] not in existing:
                imported += 1
                existing[item["id"]] = {
                    **item, "profile_id": None, "route": None, "parent_id": None, "discovered_at": now(),
                }
        save(path, {"category": SCENARIOS, "items": list(existing.values())})

    state = load(STATE, {}) or {}
    state["scenario_scan"] = {
        "scanned_at": scan["scanned_at"], "found": scan["found"], "counts": scan["counts"],
    }
    state["updated_at"] = now()
    save(STATE, state)

    if args.json:
        print(json.dumps({**scan, "imported": imported}, indent=2, ensure_ascii=False))
        return 0

    c = scan["counts"]
    print(f"Scenario scan: {'FOUND' if scan['found'] else 'NONE'}")
    print(f"  gherkin     files={c['gherkin_files']} scenarios={c['gherkin_scenarios']}")
    print(f"  e2e         files={c['e2e_files']} tests={c['e2e_tests']}")
    print(f"  unit        files={c['unit_files']} (executed as whole suites)")
    print(f"  documented  files={c['documented_files']} (read and import manually)")
    for d in scan["sources"]["documented"][:20]:
        print(f"    * {d}")
    for r in scan["sources"]["runners"]:
        print(f"  runner      {r['runner']} ({r['config']})")
    for s in scan["sources"]["scripts"]:
        print(f"  script      {s['file']}#{s['name']}: {s['command']}")
    if args.do_import:
        print(f"imported {imported} new item(s) into the '{SCENARIOS}' inventory")
    if not scan["found"]:
        print(
            "No existing test scenarios. Generate scenarios from the inventory (features, "
            "workflows, forms, permissions), register them with 'inventory-add --category "
            "scenarios --kind generated', and execute them."
        )
    elif not args.do_import:
        print("Run again with --import to add the parsed scenarios to the inventory.")
    print(f"scan written: {SCENARIO_SCAN}")
    return 0


def scenario_list(args) -> int:
    items = normalize_inventory(load(inventory_path(SCENARIOS), []))
    results = load_results(SCENARIOS)
    rows = []
    for item in items:
        iid = str(item.get("id"))
        meta = item.get("metadata") or {}
        r = results.get(iid) or {}
        rows.append({
            "id": iid,
            "origin": meta.get("origin", "generated" if item.get("kind") == "generated" else ""),
            "kind": item.get("kind") or "",
            "title": item.get("label") or "",
            "source": meta.get("source", ""),
            "covers": ", ".join(meta.get("covers", []) or []),
            "steps": meta.get("steps", []) or [],
            "expected": meta.get("expected", ""),
            "status": (r.get("status") or "").upper() or "NOT TESTED",
        })
    if args.format == "json":
        out = json.dumps({"rows": rows, "total": len(rows)}, indent=2, ensure_ascii=False)
    else:
        lines = ["# Test scenarios", ""]
        if not rows:
            lines.append("No test scenarios have been imported or generated yet.")
        else:
            lines += ["| ID | Origin | Kind | Title | Source | Covers | Status |", "|---|---|---|---|---|---|---|"]
            for r in rows:
                cells = [r["id"], r["origin"], r["kind"], r["title"], r["source"], r["covers"], r["status"]]
                lines.append("| " + " | ".join(str(x).replace("|", "\\|") for x in cells) + " |")
            detailed = [r for r in rows if r["steps"] or r["expected"]]
            if detailed:
                lines += ["", "## Steps", ""]
                for r in detailed:
                    lines.append(f"### {r['title'] or r['id']}")
                    lines.append("")
                    for i, step in enumerate(r["steps"], 1):
                        lines.append(f"{i}. {step}")
                    if r["expected"]:
                        lines += ["", f"**Expected:** {r['expected']}"]
                    lines.append("")
            pending = sum(1 for r in rows if r["status"] == "NOT TESTED")
            lines += ["", f"Scenarios: {len(rows)} | not tested: {pending}"]
        out = "\n".join(lines)
    if args.out:
        target = Path(args.out)
        if not target.is_absolute():
            target = ROOT / target
        target.parent.mkdir(parents=True, exist_ok=True)
        target.write_text(out + "\n", encoding="utf-8")
        print(f"scenario list written: {target}")
    else:
        print(out)
    return 0


def finish(args) -> None:
    code = validate(args)
    if code != 0 and not args.force:
        raise SystemExit(
            "Cannot finish: coverage is incomplete. Use --force only to close an intentionally "
            "incomplete audit; the run will be recorded as closed_incomplete."
        )
    state = load(STATE, {}) or {}
    state["status"] = "complete" if code == 0 else "closed_incomplete"
    state["finished_at"] = now()
    state["updated_at"] = now()
    save(STATE, state)
    print(f"QA run closed: {state['status']}")


# --------------------------------------------------------------- docs/qa export
#
# A second, publishable surface on top of `.qa/`. It never writes into `.qa/`
# (the one exception is stamping `bug_id` onto a result already exported into
# `docs/qa/`). Everything here derives from the inventory and results that the
# categories above already produce, so there is nothing to invent: a scenario
# with no recorded result is NOT_EXECUTED, never guessed at.


def git_value(args_list: list[str]) -> str:
    """Return a trimmed git value, or the literal NOT_AVAILABLE.

    Never raises: a project outside a git repo, or without git installed, is a
    valid state, not an error.
    """
    try:
        result = subprocess.run(
            ["git", *args_list], cwd=ROOT, capture_output=True, text=True, timeout=5,
        )
    except (OSError, subprocess.SubprocessError):
        return "NOT_AVAILABLE"
    if result.returncode != 0:
        return "NOT_AVAILABLE"
    value = result.stdout.strip()
    return value if value else "NOT_AVAILABLE"


def scenario_dir_name(scenario_id: str) -> str:
    """A filesystem-safe, unique, human-readable folder name for a scenario ID.

    Scenario IDs may contain characters that are unsafe or ambiguous as a
    directory name (':', '/', spaces). The same scenario ID always maps to the
    same folder name, and the trailing hash keeps two different IDs that
    sanitize to the same prefix from colliding.
    """
    safe = re.sub(r"[^a-zA-Z0-9._-]+", "_", scenario_id)[:120]
    digest = hashlib.sha1(scenario_id.encode("utf-8")).hexdigest()[:8]
    return f"{safe}-{digest}"


def scenario_metadata(scenario_id: str) -> dict:
    """Look up the metadata of one scenario straight from the `.qa/` inventory."""
    for item in normalize_inventory(load(inventory_path(SCENARIOS), [])):
        if str(item.get("id")) == scenario_id:
            return item.get("metadata") or {}
    return {}


def map_scenario_status(result: dict | None) -> str:
    if not result:
        return "NOT_EXECUTED"
    return STATUS_MAP.get(result.get("status"), "NOT_EXECUTED")


def evidence_subdir(path: Path) -> str:
    ext = path.suffix.lower()
    name_lower = path.name.lower()
    if ext in {".png", ".jpg", ".jpeg", ".webp"}:
        return "screenshots"
    if ext in {".webm", ".mp4"}:
        return "videos"
    if ext == ".zip":
        return "traces"
    if ext == ".log":
        return "logs"
    if ext in {".txt", ".json"}:
        if "console" in name_lower:
            return "console"
        if "network" in name_lower:
            return "network"
    return "logs"


def is_text_evidence(path: Path) -> bool:
    return path.suffix.lower() not in BINARY_EVIDENCE_EXTENSIONS


_SECRET_KV_PATTERNS = [
    re.compile(r"(authorization\s*:\s*bearer\s+)(\S+)", re.I),
    re.compile(r"(password\s*[:=]\s*)(\S+)", re.I),
    re.compile(r"(token\s*[:=]\s*)(\S+)", re.I),
    re.compile(r"(cookie\s*:\s*)(.+)", re.I),
    re.compile(r"(api[_-]?key\s*[:=]\s*)(\S+)", re.I),
]
_SECRET_WHOLE_PATTERNS = [
    re.compile(r"\d{3}\.\d{3}\.\d{3}-\d{2}"),  # CPF, formatted
    re.compile(r"(?<!\d)\d{11}(?!\d)"),  # CPF, unformatted
]


def sanitize_text(text: str) -> tuple[str, bool]:
    """Redact likely secrets from evidence text before it is published.

    Returns (clean_text, was_redacted). The rest of the line is kept so the
    evidence stays readable; only the captured secret value is replaced.
    """
    redacted = False

    def repl_kv(m: re.Match) -> str:
        nonlocal redacted
        redacted = True
        return m.group(1) + "***REDACTED***"

    def repl_whole(_m: re.Match) -> str:
        nonlocal redacted
        redacted = True
        return "***REDACTED***"

    for rx in _SECRET_KV_PATTERNS:
        text = rx.sub(repl_kv, text)
    for rx in _SECRET_WHOLE_PATTERNS:
        text = rx.sub(repl_whole, text)
    return text, redacted


def copy_scenario_evidence(execution_id: str, dirname: str, evidence_list: list) -> tuple[list, bool]:
    """Copy one scenario's evidence files into docs/qa/evidence, sanitized.

    Files that no longer exist on disk are skipped silently: a missing
    evidence file must never break an export. Returns the new, docs/qa-relative
    evidence paths and whether anything had to be redacted.
    """
    new_evidence: list[str] = []
    redacted_any = False
    for rel in evidence_list or []:
        if not rel:
            continue
        src = Path(rel)
        if not src.is_absolute():
            src = ROOT / rel
        if not src.exists() or not src.is_file():
            continue
        subdir = evidence_subdir(src)
        dest_dir = DOCS_EVIDENCE / execution_id / dirname / subdir
        dest_dir.mkdir(parents=True, exist_ok=True)
        dest = dest_dir / src.name
        if is_text_evidence(src):
            try:
                raw = src.read_text(encoding="utf-8", errors="replace")
                clean, was_redacted = sanitize_text(raw)
                dest.write_text(clean, encoding="utf-8")
                if was_redacted:
                    redacted_any = True
            except OSError:
                # Could not safely read this file as text. Never persist the
                # raw bytes under uncertainty.
                dest.write_text("EVIDENCE_REDACTED", encoding="utf-8")
                redacted_any = True
        else:
            try:
                shutil.copy2(src, dest)
            except OSError:
                continue
        new_evidence.append(dest.relative_to(ROOT).as_posix())
    return new_evidence, redacted_any


def materialize_docs_readme() -> None:
    readme = DOCS_QA / "README.md"
    if readme.exists():
        return
    templates = Path(__file__).resolve().parent / "templates"
    src = templates / "docs-qa-README.md"
    if src.exists():
        DOCS_QA.mkdir(parents=True, exist_ok=True)
        shutil.copy2(src, readme)


def execution_start(args) -> None:
    ensure_docs_dirs()
    execution_id = f"exec-{dt.datetime.now(dt.timezone.utc).strftime('%Y%m%dT%H%M%SZ')}"
    env: dict[str, str] = {}
    for kv in args.environment or []:
        if "=" in kv:
            k, v = kv.split("=", 1)
            env[k] = v
    branch = git_value(["rev-parse", "--abbrev-ref", "HEAD"])
    commit = git_value(["rev-parse", "HEAD"])
    data = {
        "execution_id": execution_id,
        "project": ROOT.name,
        "branch": branch,
        "commit": commit,
        "environment": env,
        "base_url": args.base_url or "NOT_AVAILABLE",
        "started_at": now(),
        "finished_at": None,
        "executor": args.executor or "NOT_AVAILABLE",
        "test_framework": args.test_framework or "NOT_AVAILABLE",
        "browser": args.browser or "NOT_AVAILABLE",
        "browser_version": args.browser_version or "NOT_AVAILABLE",
        "status": "in_progress",
    }
    exec_dir = DOCS_EXECUTIONS / execution_id
    save(exec_dir / "execution.json", data)
    save(exec_dir / "environment.json", {
        "branch": branch,
        "commit": commit,
        "base_url": data["base_url"],
        "browser": data["browser"],
        "browser_version": data["browser_version"],
        "environment": env,
    })
    materialize_docs_readme()
    print(execution_id)


def format_numbered(items: list) -> str:
    if not items:
        return "NOT_AVAILABLE"
    return "\n".join(f"{i}. {s}" for i, s in enumerate(items, 1))


def write_scenario_report(scen_dir: Path, result_doc: dict, meta: dict, execution: dict) -> None:
    preconditions = meta.get("preconditions") or "NOT_AVAILABLE"
    steps_text = format_numbered(meta.get("steps") or [])
    expected = meta.get("expected") or "NOT_AVAILABLE"
    obtained = result_doc.get("notes") or "NOT_AVAILABLE"

    evidence_list = result_doc.get("evidence") or []
    if evidence_list:
        evidence_lines = "\n".join(
            f"- [{Path(e).name}]({os.path.relpath(ROOT / e, scen_dir)})" for e in evidence_list
        )
    else:
        evidence_lines = "No evidence recorded."

    lines = [
        "# Scenario",
        "",
        f"ID: {result_doc['scenario_id']}",
        f"Requirement: {result_doc.get('requirement_id') or 'NOT_AVAILABLE'}",
        f"Rule: {meta.get('business_rule') or 'NOT_AVAILABLE'}",
        f"Acceptance criteria: {meta.get('acceptance_criteria') or 'NOT_AVAILABLE'}",
        "",
        "## Objective",
        "",
        result_doc.get("label") or "NOT_AVAILABLE",
        "",
        "## Preconditions",
        "",
        preconditions,
        "",
        "## Steps executed",
        "",
        steps_text,
        "",
        "## Expected result",
        "",
        expected,
        "",
        "## Actual result",
        "",
        obtained,
        "",
        "## Status",
        "",
        result_doc["status"],
        "",
        "## Evidence",
        "",
        evidence_lines,
        "",
        "## Environment",
        "",
        f"Execution: {execution.get('execution_id')} - Commit: {execution.get('commit')} - "
        f"Environment: {execution.get('base_url')}",
        "",
        "## Notes",
        "",
        result_doc.get("notes") or "",
        "",
    ]
    (scen_dir / "report.md").write_text("\n".join(lines) + "\n", encoding="utf-8")


def execution_finish(args) -> int:
    ensure_dirs()
    ensure_docs_dirs()
    require_initialized()
    execution_id = args.execution
    exec_dir = DOCS_EXECUTIONS / execution_id
    exec_path = exec_dir / "execution.json"
    execution = load(exec_path)
    if execution is None:
        raise SystemExit(f"Execution '{execution_id}' not found. Run 'qa-cli execution-start' first.")
    if execution.get("finished_at"):
        raise SystemExit(
            f"Execution '{execution_id}' is already finished and is immutable. Start a new "
            "execution with 'qa-cli execution-start' instead of redoing this one."
        )
    status_value = args.status or "COMPLETED"

    items = normalize_inventory(load(inventory_path(SCENARIOS), []))
    results = load_results(SCENARIOS)
    counts = {s: 0 for s in EXPORT_STATUSES}
    for item in items:
        sid = str(item.get("id"))
        result = results.get(sid)
        status_label = map_scenario_status(result)
        counts[status_label] += 1
        meta = item.get("metadata") or {}
        dirname = scenario_dir_name(sid)
        scen_dir = exec_dir / "scenarios" / dirname
        new_evidence, redacted_any = copy_scenario_evidence(
            execution_id, dirname, (result or {}).get("evidence") or [],
        )
        notes = (result or {}).get("notes") or ""
        if redacted_any:
            suffix = "Evidence sanitized: one or more secrets were redacted before export."
            notes = f"{notes} {suffix}".strip()
        result_doc = {
            "scenario_id": sid,
            "requirement_id": meta.get("requirement_id") or "NOT_AVAILABLE",
            "status": status_label,
            "kind": item.get("kind") or "",
            "label": item.get("label") or "",
            "covers": meta.get("covers") or [],
            "evidence": new_evidence,
            "notes": notes,
            "tested_at": (result or {}).get("tested_at"),
            "bug_id": None,
        }
        save(scen_dir / "result.json", result_doc)
        write_scenario_report(scen_dir, result_doc, meta, execution)

    execution["finished_at"] = now()
    execution["status"] = status_value
    save(exec_path, execution)
    print(
        f"execution {execution_id} finished: status={status_value} "
        + " ".join(f"{k}={v}" for k, v in counts.items())
    )
    return 0


def iter_exported_results(execution_id: str) -> list[dict]:
    scenarios_dir = DOCS_EXECUTIONS / execution_id / "scenarios"
    out = []
    if scenarios_dir.exists():
        for d in sorted(scenarios_dir.iterdir()):
            r = load(d / "result.json")
            if r:
                out.append(r)
    return out


def compute_acceptance(requirement_id: str, execution_id: str, execution: dict, matched: list[dict]) -> dict:
    counts = {s: 0 for s in EXPORT_STATUSES}
    for r in matched:
        counts[r.get("status", "NOT_EXECUTED")] = counts.get(r.get("status", "NOT_EXECUTED"), 0) + 1

    fails_with_product_defect = False
    fails_without_bug = False
    fails_inconclusive = False
    for r in matched:
        if r.get("status") != "FAIL":
            continue
        bug_id = r.get("bug_id")
        if not bug_id:
            fails_without_bug = True
            continue
        bug = load(DOCS_BUGS / bug_id / "bug.json")
        classification = (bug or {}).get("classification")
        if classification == "PRODUCT_DEFECT":
            fails_with_product_defect = True
        elif classification in INCONCLUSIVE_BUG_CLASSIFICATIONS:
            fails_inconclusive = True
        else:
            # Missing or unreadable bug file: treated the same as "no bug yet".
            fails_without_bug = True

    if fails_with_product_defect:
        result = "NOT_ACCEPTED"
    elif counts.get("BLOCKED", 0) > 0 or fails_without_bug or fails_inconclusive:
        result = "BLOCKED"
    elif counts.get("NOT_EXECUTED", 0) > 0:
        result = "INCOMPLETE"
    elif counts.get("PASS", 0) > 0:
        result = "ACCEPTED"
    else:
        result = "INCOMPLETE"

    bug_ids = sorted({r["bug_id"] for r in matched if r.get("bug_id")})
    return {
        "requirement_id": requirement_id,
        "execution_id": execution_id,
        "branch": execution.get("branch"),
        "commit": execution.get("commit"),
        "environment": execution.get("base_url"),
        "total_scenarios": len(matched),
        "pass": counts.get("PASS", 0),
        "fail": counts.get("FAIL", 0),
        "blocked": counts.get("BLOCKED", 0),
        "not_executed": counts.get("NOT_EXECUTED", 0),
        "not_applicable": counts.get("NOT_APPLICABLE", 0),
        "bugs": bug_ids,
        "scenarios": [r["scenario_id"] for r in matched],
        "result": result,
        "generated_at": now(),
    }


def write_requirement_report(requirement_id: str, report: dict) -> None:
    out_dir = DOCS_REPORTS / requirement_id
    save(out_dir / "acceptance.json", report)
    exec_dir = DOCS_EXECUTIONS / report["execution_id"]
    lines = [
        "# Acceptance report",
        "",
        f"Requirement: {requirement_id}",
        f"Branch: {report['branch']}",
        f"Commit: {report['commit']}",
        f"Environment: {report['environment']}",
        "",
        f"Total scenarios: {report['total_scenarios']}",
        f"PASS: {report['pass']}",
        f"FAIL: {report['fail']}",
        f"BLOCKED: {report['blocked']}",
        f"NOT_EXECUTED: {report['not_executed']}",
        "",
        f"Bugs found: {', '.join(report['bugs']) if report['bugs'] else 'None'}",
        "",
        "Scenarios:",
    ]
    for sid in report["scenarios"]:
        dirname = scenario_dir_name(sid)
        scen_dir = exec_dir / "scenarios" / dirname
        result = load(scen_dir / "result.json") or {}
        rel = os.path.relpath(scen_dir / "report.md", out_dir)
        lines.append(f"- {sid}: {result.get('status', 'NOT_EXECUTED')} ({rel})")
    lines += ["", f"RESULT: {report['result']}"]
    (out_dir / "ACCEPTANCE-REPORT.md").write_text("\n".join(lines) + "\n", encoding="utf-8")


def requirement_report(args) -> int:
    ensure_docs_dirs()
    execution_id = args.execution
    execution = load(DOCS_EXECUTIONS / execution_id / "execution.json")
    if execution is None:
        raise SystemExit(f"Execution '{execution_id}' not found.")
    if not execution.get("finished_at"):
        raise SystemExit(
            f"Execution '{execution_id}' has not been finished yet. Run 'qa-cli execution-finish "
            f"--execution {execution_id}' before generating a requirement report."
        )
    requirement_id = args.requirement_id
    matched = [
        r for r in iter_exported_results(execution_id)
        if r.get("requirement_id") == requirement_id
    ]
    if not matched:
        raise SystemExit(
            f"No scenario in execution '{execution_id}' points to requirement '{requirement_id}'. "
            "Nothing can be reported without data."
        )
    report = compute_acceptance(requirement_id, execution_id, execution, matched)
    write_requirement_report(requirement_id, report)
    print(report["result"])
    return 0


def retest_table(history: list[dict]) -> str:
    if not history:
        return "No retest recorded yet."
    lines = ["| execution_id | result | tested_at |", "|---|---|---|"]
    for h in history:
        lines.append(f"| {h.get('execution_id')} | {h.get('result')} | {h.get('tested_at')} |")
    return "\n".join(lines)


def write_bug_report(bug_dir: Path, bug: dict) -> None:
    meta = scenario_metadata(bug.get("scenario_id", ""))
    preconditions = meta.get("preconditions") or "NOT_AVAILABLE"
    steps_text = format_numbered(meta.get("steps") or [])
    expected = meta.get("expected") or "NOT_AVAILABLE"

    evidence = bug.get("evidence") or []
    evidence_lines = "\n".join(f"- {e}" for e in evidence) if evidence else "No evidence recorded."
    screenshots = [e for e in evidence if "/screenshots/" in e]
    logs = [e for e in evidence if "/logs/" in e]
    console = [e for e in evidence if "/console/" in e]
    network = [e for e in evidence if "/network/" in e]

    def section(items: list) -> str:
        return "\n".join(f"- {e}" for e in items) if items else "None."

    lines = [
        "# Bug report",
        "",
        "## Identification",
        "",
        f"Bug ID: {bug['bug_id']}",
        f"Requirement: {bug.get('requirement_id') or 'NOT_AVAILABLE'}",
        f"Scenario: {bug.get('scenario_id')}",
        f"Execution: {bug.get('execution_id')}",
        f"Commit: {bug.get('commit')}",
        "",
        "## Summary",
        "",
        bug.get("summary") or "NOT_AVAILABLE",
        "",
        "## Preconditions",
        "",
        preconditions,
        "",
        "## Steps to reproduce",
        "",
        steps_text,
        "",
        "## Expected result",
        "",
        expected,
        "",
        "## Observed result",
        "",
        bug.get("observed_fact") or "NOT_AVAILABLE",
        "",
        "## Evidence",
        "",
        evidence_lines,
        "",
        "## Screenshots",
        "",
        section(screenshots),
        "",
        "## Logs",
        "",
        section(logs),
        "",
        "## Console",
        "",
        section(console),
        "",
        "## Network",
        "",
        section(network),
        "",
        "## Environment",
        "",
        f"Execution: {bug.get('execution_id')} - Commit: {bug.get('commit')} - "
        f"Environment: {bug.get('environment') or 'NOT_AVAILABLE'}",
        "",
        "## Severity",
        "",
        bug.get("severity") or "NOT_AVAILABLE",
        "",
        "## Impact",
        "",
        bug.get("impact") or "NOT_AVAILABLE",
        "",
        "## Observed fact",
        "",
        bug.get("observed_fact") or "NOT_AVAILABLE",
        "",
        "## Technical hypothesis",
        "",
        # Deliberately kept separate from "Observed fact": a hypothesis is
        # never presented as a confirmed cause.
        bug.get("technical_hypothesis") or "Not determined. This is not a confirmed root cause.",
        "",
        "## Retest history",
        "",
        retest_table(bug.get("retest_history") or []),
        "",
    ]
    (bug_dir / "BUG-REPORT.md").write_text("\n".join(lines) + "\n", encoding="utf-8")


def bug_report(args) -> None:
    ensure_docs_dirs()
    execution_id = args.execution
    scenario_id = args.scenario
    exec_dir = DOCS_EXECUTIONS / execution_id
    dirname = scenario_dir_name(scenario_id)
    result_path = exec_dir / "scenarios" / dirname / "result.json"
    result = load(result_path)
    if result is None:
        raise SystemExit(
            f"Scenario '{scenario_id}' has no exported result in execution '{execution_id}'. "
            "Run 'qa-cli execution-finish' first."
        )
    execution = load(exec_dir / "execution.json") or {}
    bug_id = args.id or (
        f"BUG-{dt.datetime.now().strftime('%Y%m%d%H%M%S')}-"
        f"{hashlib.sha1((scenario_id + now()).encode()).hexdigest()[:5]}"
    )
    severity = normalize_severity(args.severity) if args.severity else None
    bug = {
        "bug_id": bug_id,
        "requirement_id": result.get("requirement_id") or "NOT_AVAILABLE",
        "scenario_id": scenario_id,
        "execution_id": execution_id,
        "commit": execution.get("commit", "NOT_AVAILABLE"),
        "environment": execution.get("base_url", "NOT_AVAILABLE"),
        "classification": args.classification,
        "severity": severity,
        "summary": args.summary,
        "observed_fact": args.observed_fact,
        "technical_hypothesis": args.hypothesis,
        "evidence": result.get("evidence") or [],
        "created_at": now(),
        "retest_history": [],
    }
    bug_dir = DOCS_BUGS / bug_id
    save(bug_dir / "bug.json", bug)
    write_bug_report(bug_dir, bug)
    result["bug_id"] = bug_id
    save(result_path, result)
    print(bug_id)


def retest(args) -> int:
    bug_id = args.bug
    bug_path = DOCS_BUGS / bug_id / "bug.json"
    bug = load(bug_path)
    if bug is None:
        raise SystemExit(f"Bug '{bug_id}' not found. Run 'qa-cli bug-report' first.")
    entry = {"execution_id": args.execution, "result": args.result, "tested_at": now()}
    bug.setdefault("retest_history", []).append(entry)
    save(bug_path, bug)
    write_bug_report(DOCS_BUGS / bug_id, bug)
    print(f"retest recorded for {bug_id}: {args.result} ({args.execution})")
    return 0


def bug_is_retested(bug: dict) -> bool:
    history = bug.get("retest_history") or []
    return bool(history and history[-1].get("result") == "PASS")


def bugs_list(args) -> int:
    rows = []
    if DOCS_BUGS.exists():
        for d in sorted(DOCS_BUGS.iterdir()):
            bug = load(d / "bug.json")
            if not bug:
                continue
            history = bug.get("retest_history") or []
            latest = history[-1] if history else None
            status_label = "retested" if bug_is_retested(bug) else "open"
            if args.status and args.status != status_label:
                continue
            if args.classification and bug.get("classification") != args.classification:
                continue
            rows.append({
                "bug_id": bug["bug_id"],
                "requirement_id": bug.get("requirement_id") or "NOT_AVAILABLE",
                "scenario_id": bug.get("scenario_id") or "",
                "classification": bug.get("classification") or "",
                "severity": bug.get("severity") or "NOT_AVAILABLE",
                "status": status_label,
                "latest_retest": f"{latest['result']} ({latest['execution_id']})" if latest else "None",
            })
    if args.format == "json":
        print(json.dumps({"rows": rows, "total": len(rows)}, indent=2, ensure_ascii=False))
        return 0
    header = ["Bug ID", "Requirement", "Scenario", "Classification", "Severity", "Status", "Latest retest"]
    keys = ["bug_id", "requirement_id", "scenario_id", "classification", "severity", "status", "latest_retest"]
    lines = ["| " + " | ".join(header) + " |", "|" + "---|" * len(header)]
    for r in rows:
        cells = [str(r[k]).replace("|", "\\|") for k in keys]
        lines.append("| " + " | ".join(cells) + " |")
    lines.append("")
    lines.append(f"Bugs: {len(rows)}")
    print("\n".join(lines))
    return 0


def write_final_report_md(out_dir: Path, summary: dict) -> None:
    by_class = summary["bugs_by_classification"]
    lines = [
        "# QA EXECUTION REPORT",
        "",
        f"Project: {summary['project']}",
        f"Branch: {summary['branch']}",
        f"Commit: {summary['commit']}",
        f"Environment: {summary['environment']}",
        f"Execution: {summary['execution_id']}",
        "",
        f"Requirements evaluated: {summary['requirements_evaluated']}",
        f"Scenarios executed: {summary['scenarios_executed']}",
        "",
        f"PASS: {summary['pass']}",
        f"FAIL: {summary['fail']}",
        f"BLOCKED: {summary['blocked']}",
        f"NOT_EXECUTED: {summary['not_executed']}",
        "",
        f"Bugs (PRODUCT_DEFECT): {by_class.get('PRODUCT_DEFECT', 0)}",
        f"Automation failures (TEST_AUTOMATION_FAILURE): {by_class.get('TEST_AUTOMATION_FAILURE', 0)}",
        f"Environment failures (ENVIRONMENT_FAILURE): {by_class.get('ENVIRONMENT_FAILURE', 0)}",
        f"Data failures (TEST_DATA_FAILURE): {by_class.get('TEST_DATA_FAILURE', 0)}",
        "",
        f"Overall result: {summary['overall_result']}",
        "",
        "| Requirement | Scenarios | PASS | FAIL | BLOCKED | Result |",
        "|---|---|---|---|---|---|",
    ]
    for r in summary["requirements"]:
        lines.append(
            f"| {r['requirement_id']} | {r['scenarios']} | {r['pass']} | {r['fail']} | "
            f"{r['blocked']} | {r['result']} |"
        )
    (out_dir / "FINAL-REPORT.md").write_text("\n".join(lines) + "\n", encoding="utf-8")


def write_evidence_manifest(out_dir: Path, execution_id: str, all_results: list[dict]) -> None:
    manifest = [
        {
            "requirement_id": r.get("requirement_id") or "NOT_AVAILABLE",
            "scenario_id": r["scenario_id"],
            "test_id": r["scenario_id"],
            "execution_id": execution_id,
            "status": r.get("status", "NOT_EXECUTED"),
            "evidence": r.get("evidence") or [],
            "bug_id": r.get("bug_id"),
        }
        for r in all_results
    ]
    save(out_dir / "evidence-manifest.json", manifest)


OVERALL_RANK = {"ACCEPTED": 0, "INCOMPLETE": 1, "BLOCKED": 2, "NOT_ACCEPTED": 3}


def final_report(args) -> int:
    ensure_docs_dirs()
    execution_id = args.execution
    execution = load(DOCS_EXECUTIONS / execution_id / "execution.json")
    if execution is None:
        raise SystemExit(f"Execution '{execution_id}' not found.")
    if not execution.get("finished_at"):
        raise SystemExit(
            f"Execution '{execution_id}' has not been finished yet. Run 'qa-cli execution-finish "
            f"--execution {execution_id}' first."
        )
    all_results = iter_exported_results(execution_id)
    requirement_ids = sorted({
        r["requirement_id"] for r in all_results
        if r.get("requirement_id") and r["requirement_id"] != "NOT_AVAILABLE"
    })

    req_rows = []
    overall = "ACCEPTED"
    for rid in requirement_ids:
        matched = [r for r in all_results if r.get("requirement_id") == rid]
        report = compute_acceptance(rid, execution_id, execution, matched)
        write_requirement_report(rid, report)
        req_rows.append({
            "requirement_id": rid,
            "scenarios": report["total_scenarios"],
            "pass": report["pass"],
            "fail": report["fail"],
            "blocked": report["blocked"],
            "result": report["result"],
        })
        if OVERALL_RANK[report["result"]] > OVERALL_RANK[overall]:
            overall = report["result"]

    status_counts = {s: 0 for s in EXPORT_STATUSES}
    for r in all_results:
        status_counts[r.get("status", "NOT_EXECUTED")] = status_counts.get(r.get("status", "NOT_EXECUTED"), 0) + 1

    bug_ids = sorted({r["bug_id"] for r in all_results if r.get("bug_id")})
    bugs_by_class: dict[str, int] = {}
    for bid in bug_ids:
        bug = load(DOCS_BUGS / bid / "bug.json")
        cls = (bug or {}).get("classification", "UNKNOWN")
        bugs_by_class[cls] = bugs_by_class.get(cls, 0) + 1

    summary = {
        "execution_id": execution_id,
        "project": execution.get("project"),
        "branch": execution.get("branch"),
        "commit": execution.get("commit"),
        "environment": execution.get("base_url"),
        "requirements_evaluated": len(requirement_ids),
        "scenarios_executed": len(all_results),
        "pass": status_counts.get("PASS", 0),
        "fail": status_counts.get("FAIL", 0),
        "blocked": status_counts.get("BLOCKED", 0),
        "not_executed": status_counts.get("NOT_EXECUTED", 0),
        "bugs_by_classification": bugs_by_class,
        "overall_result": overall,
        "requirements": req_rows,
    }
    out_dir = DOCS_SUMMARY / execution_id
    save(out_dir / "summary.json", summary)
    write_final_report_md(out_dir, summary)
    write_evidence_manifest(out_dir, execution_id, all_results)
    print(f"final report: {execution_id} overall={overall}")
    return 0


def parser() -> argparse.ArgumentParser:
    p = argparse.ArgumentParser(description="Claude Code QA coverage state CLI")
    sp = p.add_subparsers(dest="cmd", required=True)

    q = sp.add_parser("init", help="initialize or resume the project-local QA state")
    q.add_argument("--goal")
    q.add_argument("--force", action="store_true")
    q.set_defaults(fn=init)

    q = sp.add_parser("inventory-add", help="add or update one inventory item")
    q.add_argument("--category", required=True)
    q.add_argument("--id", required=True)
    q.add_argument("--kind", default="item")
    q.add_argument("--label", default="")
    q.add_argument("--profile-id")
    q.add_argument("--route")
    q.add_argument("--parent-id")
    q.add_argument("--metadata")
    q.set_defaults(fn=add_inventory)

    q = sp.add_parser("record", help="persist the result of testing one inventory item")
    q.add_argument("--category", required=True)
    q.add_argument("--id", required=True)
    q.add_argument("--status", required=True)
    q.add_argument("--profile-id")
    q.add_argument("--evidence", action="append")
    q.add_argument("--notes")
    q.add_argument("--scenario")
    q.add_argument("--finding-id", action="append")
    q.add_argument("--tester")
    q.set_defaults(fn=record)

    q = sp.add_parser("finding", help="record a traceable defect")
    q.add_argument("--id")
    q.add_argument("--title", required=True)
    q.add_argument("--severity", required=True,
                   help="critical|high|medium|low (P0|P1|P2|P3 accepted as aliases)")
    q.add_argument("--category", required=True)
    q.add_argument("--profile-id")
    q.add_argument("--location")
    q.add_argument("--actual")
    q.add_argument("--expected")
    q.add_argument("--reproduction")
    q.add_argument("--impact")
    q.add_argument("--recommendation")
    q.add_argument("--evidence", action="append")
    q.set_defaults(fn=add_finding)

    q = sp.add_parser("declare-empty",
                      help="declare a category as having no applicable items, with justification")
    q.add_argument("--category", required=True)
    q.add_argument("--notes", required=True)
    q.set_defaults(fn=declare_empty)

    q = sp.add_parser("mark-discovery-complete", help="mark the discovery phase as finished")
    q.add_argument("--notes")
    q.set_defaults(fn=mark_discovery)

    q = sp.add_parser("status", help="show coverage and audit state")
    q.add_argument("--json", action="store_true")
    q.set_defaults(fn=status)

    q = sp.add_parser("validate", help="fail unless the configured coverage is satisfied")
    q.set_defaults(fn=validate)

    q = sp.add_parser("matrix", help="generate the traceability matrix")
    q.add_argument("--format", choices=["markdown", "json"], default="markdown")
    q.add_argument("--out", help="write to this path instead of stdout")
    q.set_defaults(fn=matrix)

    q = sp.add_parser("scenario-scan",
                      help="detect the test scenarios the project already has (gherkin, e2e, suites, documents)")
    q.add_argument("--import", dest="do_import", action="store_true",
                   help="add the parsed scenarios and suites to the scenarios inventory")
    q.add_argument("--json", action="store_true")
    q.set_defaults(fn=scenario_scan)

    q = sp.add_parser("scenario-list", help="list the scenarios inventory with steps and status")
    q.add_argument("--format", choices=["markdown", "json"], default="markdown")
    q.add_argument("--out", help="write to this path instead of stdout")
    q.set_defaults(fn=scenario_list)

    q = sp.add_parser("finish", help="close the audit run")
    q.add_argument("--force", action="store_true")
    q.set_defaults(fn=finish)

    q = sp.add_parser("execution-start", help="start a new, immutable docs/qa execution")
    q.add_argument("--environment", action="append", help="KEY=VALUE, repeatable")
    q.add_argument("--base-url")
    q.add_argument("--executor")
    q.add_argument("--test-framework")
    q.add_argument("--browser")
    q.add_argument("--browser-version")
    q.set_defaults(fn=execution_start)

    q = sp.add_parser("execution-finish", help="export every scenario result into docs/qa and close the execution")
    q.add_argument("--execution", required=True)
    q.add_argument("--status", choices=["COMPLETED", "ABORTED"], default="COMPLETED")
    q.set_defaults(fn=execution_finish)

    q = sp.add_parser("requirement-report", help="compute the deterministic acceptance result for one requirement")
    q.add_argument("requirement_id")
    q.add_argument("--execution", required=True)
    q.set_defaults(fn=requirement_report)

    q = sp.add_parser("bug-report", help="record a bug tied to one exported scenario result")
    q.add_argument("--scenario", required=True)
    q.add_argument("--execution", required=True)
    q.add_argument("--classification", required=True, choices=BUG_CLASSIFICATIONS)
    q.add_argument("--summary", required=True)
    q.add_argument("--observed-fact", required=True)
    q.add_argument("--hypothesis")
    q.add_argument("--severity", help="critical|high|medium|low (P0|P1|P2|P3 accepted as aliases)")
    q.add_argument("--id")
    q.set_defaults(fn=bug_report)

    q = sp.add_parser("retest", help="append a retest outcome to a bug, without erasing its history")
    q.add_argument("--bug", required=True)
    q.add_argument("--execution", required=True)
    q.add_argument("--result", required=True, choices=["PASS", "FAIL", "BLOCKED"])
    q.set_defaults(fn=retest)

    q = sp.add_parser("bugs-list", help="list bugs recorded in docs/qa/bugs")
    q.add_argument("--status", choices=["open", "retested"])
    q.add_argument("--classification", choices=BUG_CLASSIFICATIONS)
    q.add_argument("--format", choices=["markdown", "json"], default="markdown")
    q.set_defaults(fn=bugs_list)

    q = sp.add_parser("final-report", help="aggregate every requirement's acceptance into one execution summary")
    q.add_argument("--execution", required=True)
    q.set_defaults(fn=final_report)
    return p


if __name__ == "__main__":
    parsed = parser().parse_args()
    rc = parsed.fn(parsed)
    if isinstance(rc, int):
        sys.exit(rc)
